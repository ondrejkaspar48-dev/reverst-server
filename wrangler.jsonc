
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reverst-server",
  "main": "./index.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "IP_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
